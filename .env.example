# Configuración de Meta WhatsApp Cloud API
META_APP_SECRET=tu_app_secret_de_meta_aqui
META_VERIFY_TOKEN=tu_token_de_verificacion_webhook_aqui
META_ACCESS_TOKEN=tu_token_de_acceso_permanente_aqui
META_PHONE_NUMBER_ID=tu_phone_number_id_aqui
GRAPH_API_VERSION=v26.0

# Upstash Redis (Contador y control de idempotencia vía REST API)
UPSTASH_REDIS_REST_URL=https://tu-base-de-datos.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash_aqui

# Control de Cupo y Mensajería (Valores numéricos)
LIMITE_MENSUAL=1000
UMBRAL_CORTE=950
PERMITIR_EMERGENCIAS_TRAS_CORTE=true
TIMEZONE=America/Caracas

# Servidor y Alertas
PORT=8000
ALERT_EMAIL=admin@asociacion.org
